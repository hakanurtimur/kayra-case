{
  "name": "kayra",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.2",
  "scripts": {
    "build": "pnpm -r --filter \"./apps/*\" build",
    "dev:cart": "pnpm --filter @kayra/cart dev",
    "dev:home": "pnpm --filter @kayra/home dev",
    "lint": "eslint apps packages tests --max-warnings=0",
    "test": "pnpm test:routes && pnpm test:unit",
    "test:api": "pnpm test:unit:build && node --test .test-dist/tests/phase2-api.test.js",
    "test:api:build": "pnpm test:unit:build",
    "test:cart-api": "pnpm test:unit:build && node --test .test-dist/tests/phase3-cart-api.test.js",
    "test:cart-contract": "pnpm test:unit:build && node --test .test-dist/tests/phase3-cart-contract.test.js",
    "test:unit": "pnpm test:unit:build && node --test .test-dist/tests/phase2-api.test.js .test-dist/tests/phase3-cart-api.test.js .test-dist/tests/phase3-cart-contract.test.js .test-dist/tests/phase3-cart-lines.test.js .test-dist/tests/phase5-catalog.test.js",
    "test:unit:build": "tsc -p tsconfig.test.json",
    "test:routes": "node --test tests/phase1-routing.test.mjs tests/phase5-ui-contract.test.mjs",
    "typecheck": "pnpm -r --filter \"./apps/*\" --filter \"./packages/*\" typecheck"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
