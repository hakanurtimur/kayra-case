{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": ".test-dist",
    "baseUrl": ".",
    "paths": {
      "@kayra/types": ["packages/types/src/index.ts"],
      "@kayra/cart-contract": ["packages/cart-contract/src/index.ts"]
    },
    "rootDir": "."
  },
  "include": [
    "apps/cart/lib/**/*.ts",
    "apps/home/lib/**/*.ts",
    "packages/cart-contract/src/**/*.ts",
    "packages/types/src/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", ".test-dist"]
}
